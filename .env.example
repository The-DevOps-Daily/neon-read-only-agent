# A Neon API key (Account settings > API keys). The scripts create ONE
# throwaway project, seed it, create roles, run the probes, and delete the
# project at the end.
NEON_API_KEY=

# Optional
# NEON_ORG_ID=            # organization to create the project in
# NEON_REGION=aws-us-east-2
# PG_VERSION=18
# SEED_ORDERS=5000        # size of the fake orders table

# The Neon MCP Server the probes call. The hosted server is the default.
# NEON_MCP_URL=https://mcp.neon.tech/mcp
